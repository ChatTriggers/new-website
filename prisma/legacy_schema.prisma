generator legacy-client {
  provider = "prisma-client-js"
  output   = "./generated/legacy-client"
}

datasource db {
  provider = "postgresql"
  url      = env("OLD_DATABASE_URL")
}

model modules {
  id          BigInt     @id(map: "idx_24688_primary") @default(autoincrement())
  user_id     BigInt
  name        String     @unique(map: "idx_24688_modules_name_unique") @db.Citext
  description String
  image       String?    @db.VarChar(50)
  downloads   BigInt     @default(0)
  hidden      Boolean    @default(false)
  created_at  DateTime?  @db.Timestamptz(6)
  updated_at  DateTime?  @db.Timestamptz(6)
  tags        String?    @default("") @db.VarChar(2000)
  releases    releases[]
}

model passwordresets {
  email      String   @db.VarChar(191)
  token      String   @id @db.VarChar(36)
  expiration DateTime @db.Timestamptz(6)
}

model releases {
  id                   String   @id(map: "idx_24700_primary") @db.Uuid
  module_id            BigInt
  release_version      String   @db.VarChar(20)
  mod_version          String   @db.VarChar(20)
  changelog            String
  downloads            Int      @default(0)
  created_at           DateTime @db.Timestamptz(6)
  updated_at           DateTime @db.Timestamptz(6)
  verified             Boolean  @default(false)
  verification_token   String?  @db.VarChar(36)
  verification_message BigInt?
  modules              modules  @relation(fields: [module_id], references: [id], onUpdate: Restrict, map: "fk_releases_module_id_id")

  @@index([module_id], map: "idx_24700_fk_releases_module_id_id")
}

model trackedtimestamps {
  id           Int          @id(map: "idx_24708_primary") @default(autoincrement())
  user         Int
  time         DateTime     @db.Date
  trackedusers trackedusers @relation(fields: [user], references: [id], onUpdate: Restrict, map: "trackedtimestamps_ibfk_1")

  @@index([user], map: "idx_24708_user")
}

model trackedusers {
  id                Int                 @id(map: "idx_24713_primary") @default(autoincrement())
  hash              String              @unique(map: "idx_24713_hash") @db.VarChar(100)
  version           String              @default("2.0.0") @db.VarChar(20)
  trackedtimestamps trackedtimestamps[]
}

model users {
  id             BigInt    @id(map: "idx_24719_primary") @default(autoincrement())
  name           String    @unique(map: "idx_24719_users_name_unique") @db.Citext
  email          String    @unique(map: "idx_24719_users_email_unique") @db.Citext
  password       String    @db.VarChar(191)
  rank           String    @default("default") @db.VarChar(30)
  remember_token String?   @db.VarChar(100)
  created_at     DateTime? @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
}
