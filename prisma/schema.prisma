generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Module {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id])
  name        String    @unique @db.VarChar(64)
  summary     String?   @db.VarChar(300)
  description String?   @db.Text
  has_image   Boolean   @default(false)
  has_icon    Boolean   @default(false)
  downloads   Int       @default(0)
  hidden      Boolean   @default(false)
  tags        String?   @db.VarChar(200) // comma-separated array
  releases    Release[]

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("modules")
}

model Release {
  id                      String    @id @default(uuid())
  module_id               String
  module                  Module    @relation(fields: [module_id], references: [id])
  release_version         String    @db.VarChar(32)
  mod_version             String    @db.VarChar(16)
  changelog               String?   @db.Text
  downloads               Int       @default(0)
  verified                Boolean   @default(false)
  verification_message_id String?   @db.VarChar(64)
  verified_by_id          String?
  verified_at             DateTime?

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@map("releases")
}

model User {
  id                    String         @id @default(uuid())
  name                  String         @unique @db.VarChar(32)
  email                 String         @unique @db.VarChar(192)
  email_verified        Boolean
  password              String         @db.VarChar(192)
  last_name_change_time DateTime?
  verification_token    String?
  password_reset_token  String?
  has_image             Boolean        @default(false)
  rank                  Rank           @default(default)
  notifications         Notification[]
  modules               Module[]

  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  @@map("users")
}

model Email {
  id         Int       @id @default(autoincrement())
  type       EmailType
  subtype    String?   @db.VarChar(50)
  recipient  String    @db.VarChar(255)
  timestamp  String    @db.VarChar(100)

  created_at DateTime  @default(now())

  @@map("emails")
}

model Notification {
  id          Int      @id @default(autoincrement())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  title       String   @db.VarChar(255)
  description String?  @db.Text
  read        Boolean

  created_at  DateTime @default(now())

  @@map("notifications")
}

model TrackedTimestamp {
  id           Int          @id(map: "idx_24708_primary") @default(autoincrement())
  user         Int
  time         DateTime     @db.Date
  tracked_user TrackedUser  @relation(fields: [user], references: [id], onUpdate: Restrict, map: "trackedtimestamps_ibfk_1")

  @@index([user], map: "idx_24708_user")
  @@map("trackedtimestamps")
}

model TrackedUser {
  id                 Int                 @id(map: "idx_24713_primary") @default(autoincrement())
  hash               String              @unique(map: "idx_24713_hash") @db.VarChar(100)
  version            String              @default("2.0.0") @db.VarChar(20)
  tracked_timestamps TrackedTimestamp[]

  @@map("trackedusers")
}

enum EmailType {
  delivery
  bounce
  complaint
}

enum Rank {
  default
  trusted
  admin
}
